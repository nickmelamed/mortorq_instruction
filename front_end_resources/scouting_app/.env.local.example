# Copy this file to .env.local (which .gitignore already excludes --
# Vite's default template ignores *.local) and fill in a real key.
# Get a free read key at https://www.thebluealliance.com/account
# (Account -> "Read API Keys" -> Add New Key). See
# frontend_systems_primer/01_consuming_apis/concept.md for the full walkthrough.

VITE_TBA_AUTH_KEY=

# Optional -- see frontend_systems_primer/02_data_beyond_the_spreadsheet/
# concept.md. Leave both blank and the app falls back to in-memory-only
# storage; nothing breaks.
# Get these from your Supabase project's API settings after creating a
# project at https://supabase.com/ and running schema.sql against it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Not a VITE_ variable -- this one is read by scripts/summarize-team.ts,
# a Node script, not by the browser app, so it does NOT go through Vite's
# import.meta.env. Export it in your shell instead:
#   export ANTHROPIC_API_KEY=sk-ant-...
# Get a key at https://console.anthropic.com/
